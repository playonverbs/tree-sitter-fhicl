{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "fhicl",
      "camelcase": "Fhicl",
      "title": "Fhicl",
      "scope": "source.fhicl",
      "file-types": [
        "fcl",
        "fhicl"
      ],
      "injection-regex": "^fhicl$",
      "class-name": "TreeSitterFhicl"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Fhicl grammar for tree-sitter",
    "authors": [
      {
        "name": "Niam Patel",
        "email": "n@playonverbs.com",
        "url": "https://playonverbs.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-fhicl",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}