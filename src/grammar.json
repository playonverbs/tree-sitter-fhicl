{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "fhicl",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "definition"
          },
          {
            "type": "SYMBOL",
            "name": "table"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PREC",
                "value": 2,
                "content": {
                  "type": "SYMBOL",
                  "name": "include"
                }
              },
              {
                "type": "PREC",
                "value": 1,
                "content": {
                  "type": "SYMBOL",
                  "name": "comment"
                }
              }
            ]
          }
        ]
      }
    },
    "include": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "#[ \t]*include"
          },
          "named": false,
          "value": "#include"
        },
        {
          "type": "FIELD",
          "name": "path",
          "content": {
            "type": "SYMBOL",
            "name": "string_atom"
          }
        }
      ]
    },
    "definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_name"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "_value"
        }
      ]
    },
    "table": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_table_body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_table_body": {
      "type": "SYMBOL",
      "name": "_table_items"
    },
    "_table_items": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_table_item"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_table_item"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": ","
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "_table_items"
            }
          ]
        }
      ]
    },
    "_table_item": {
      "type": "SYMBOL",
      "name": "definition"
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_atom"
        },
        {
          "type": "SYMBOL",
          "name": "table"
        },
        {
          "type": "SYMBOL",
          "name": "sequence"
        }
      ]
    },
    "sequence": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_sequence_items"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "_sequence_items": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_sequence_item"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_sequence_item"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": ","
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "_sequence_items"
            }
          ]
        }
      ]
    },
    "_sequence_item": {
      "type": "SYMBOL",
      "name": "_value"
    },
    "_atom": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number_atom"
        },
        {
          "type": "SYMBOL",
          "name": "string_atom"
        },
        {
          "type": "SYMBOL",
          "name": "nil_atom"
        },
        {
          "type": "SYMBOL",
          "name": "boolean_atom"
        }
      ]
    },
    "number_atom": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_integer_atom"
        },
        {
          "type": "SYMBOL",
          "name": "_decimal_atom"
        }
      ]
    },
    "_integer_atom": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "_decimal_atom": {
      "type": "PATTERN",
      "value": "\\d+\\.?\\d+"
    },
    "string_atom": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "\"(.+)\""
        },
        {
          "type": "PATTERN",
          "value": "'(.+)'"
        }
      ]
    },
    "boolean_atom": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "PATTERN",
          "value": "\"true\""
        },
        {
          "type": "STRING",
          "value": "false"
        },
        {
          "type": "PATTERN",
          "value": "\"false\""
        }
      ]
    },
    "nil_atom": {
      "type": "PATTERN",
      "value": "nil"
    },
    "_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "hname"
        }
      ]
    },
    "hname": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_atom"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "."
            },
            {
              "type": "SYMBOL",
              "name": "_bracket_index"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_atom"
        }
      ]
    },
    "_bracket_index": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "SYMBOL",
          "name": "_integer_atom"
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z1-9]+"
    },
    "comment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "//"
            },
            {
              "type": "PATTERN",
              "value": "(\\\\+(.|\\r?\\n)|[^\\\\\\n])*"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "#.+"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}